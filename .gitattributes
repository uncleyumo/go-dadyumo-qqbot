# Windows 上务必保持 LF：CRLF 的 .sh 在 Git Bash / 服务器上会直接炸
*.sh     text eol=lf
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.service text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.html   text eol=lf
*.txt    text eol=lf
# .ps1 在库里存 LF（归一化），Windows 上 checkout 时自动转成 CRLF。
# PowerShell 5.1 与 pwsh 都能读 LF，所以即使在Linux/macOS 上 clone 也不影响执行。
*.ps1    text eol=crlf
LICENSE  text eol=lf
